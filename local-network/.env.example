# Local Network Environment Variables
# Copy this file to .env and adjust as needed

# Network Settings
NETWORK_ID=1337
CHAIN_ID=1337

# Execution Client Images
OP_GETH_IMAGE=ghcr.io/unitsnetwork/op-geth:v1.101603.0-1
OP_RETH_IMAGE=ghcr.io/unitsnetwork/op-reth:simulate-v1-latest

# Consensus Client Images
LIGHTHOUSE_IMAGE=sigp/lighthouse:latest-modern

# RPC Ports
EC1_RPC_PORT=18545
EC1_WS_PORT=18546
EC1_ENGINE_PORT=18551
EC1_P2P_PORT=13030

EC2_RPC_PORT=28545
EC2_WS_PORT=28546
EC2_ENGINE_PORT=28551
EC2_P2P_PORT=23030

# Beacon Node Ports
BEACON1_P2P_PORT=19000
BEACON1_API_PORT=19002
BEACON2_P2P_PORT=29000
BEACON2_API_PORT=29002

# Logging
LOG_LEVEL=info

# Java Options (for Waves nodes, if used)
JAVA_OPTS=-Xmx2g

# Password for keystore (if needed)
KEYSTORE_PASSWORD=testpassword
