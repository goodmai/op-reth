# Local Network Configuration
# Optimism Layer 2 with eth_simulateV1 Testing

# Node Configuration
GETH_IMAGE=ghcr.io/unitsnetwork/op-geth:v1.101603.0-1
RETH_IMAGE=ghcr.io/unitsnetwork/op-reth:simulate-v1-latest
LIGHTHOUSE_IMAGE=sigp/lighthouse:latest-modern

# Network Settings
CHAIN_ID=1337
NETWORK_ID=1337

# Port Configuration
GETH_RPC_PORT=8545
GETH_WS_PORT=8546
GETH_ENGINE_PORT=18551
GETH_P2P_PORT=40303

RETH_RPC_PORT=8547
RETH_WS_PORT=8548
RETH_ENGINE_PORT=28551
RETH_P2P_PORT=50303

LIGHTHOUSE_API_PORT_1=5052
LIGHTHOUSE_API_PORT_2=5053
LIGHTHOUSE_VALIDATOR_PORT_1=5062
LIGHTHOUSE_VALIDATOR_PORT_2=5063

LIGHTHOUSE_P2P_PORT_1=9000
LIGHTHOUSE_P2P_PORT_2=9001

# Data Directories
GETH_DATA_DIR=./data/op-geth-1
RETH_DATA_DIR=./data/op-reth-2
LIGHTHOUSE_DATA_DIR_1=./data/lighthouse-1
LIGHTHOUSE_DATA_DIR_2=./data/lighthouse-2

# JWT Secret (must be 64 hex characters)
JWT_SECRET=0x4c5a3e8e9f2d1b0c7a6b5e4f3d2c1b9a8f7e6d5c4b3a2918070605040302010

# Validator Configuration
VALIDATOR_COUNT=64
SUGGESTED_FEE_RECIPIENT=0x123463a4b065722e99115d6c222f267d9cabb524

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json